<IfModule mod_rewrite.c>
  RewriteEngine On

  # Fallback: if .glb.png is requested but does not exist on disk, rewrite to .glb
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*\.glb)\.png$ $1 [L]

  # Ensure assets are served directly
  RewriteCond %{REQUEST_URI} \.(css|js|glb|gltf|svg|png|jpg|jpeg|webp|ico|json)$ [NC]
  RewriteRule ^ - [L]

  # Do not rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do not rewrite api requests
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_URI} ^.*/api/
  RewriteRule ^ - [L]

  # Fallback all other URLs to index.html for Vue SPA router
  RewriteRule . index.html [L]
</IfModule>

# Ensure correct MIME types on Apache
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType model/gltf-binary .glb
  AddType model/gltf+json .gltf
  <FilesMatch "\.glb\.png$">
    ForceType model/gltf-binary
  </FilesMatch>
</IfModule>

# Allow cross-origin requests for 3D models and fonts
<IfModule mod_headers.c>
  <FilesMatch "\.(glb|gltf|bin|png|jpg|jpeg|webp|svg|ico)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# Set DirectoryIndex so index.html is loaded before index.php
DirectoryIndex index.html index.php

