<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ensure assets are served directly
  RewriteCond %{REQUEST_URI} \.(css|js|glb|gltf|svg|png|jpg|jpeg|webp|ico|json)$ [NC]
  RewriteRule ^ - [L]

  # Do not rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Do not rewrite api requests
  RewriteCond %{REQUEST_URI} ^/api/ [OR]
  RewriteCond %{REQUEST_URI} ^.*/api/
  RewriteRule ^ - [L]

  # Fallback all other URLs to index.html for Vue SPA router
  RewriteRule . index.html [L]
</IfModule>

# Ensure correct MIME types on Apache
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType model/gltf-binary .glb
</IfModule>

# Set DirectoryIndex so index.html is loaded before index.php
DirectoryIndex index.html index.php
